{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "bootstrap:admin": "ts-node --transpile-only scripts/createFirstAdmin.ts",
    "create-account": "ts-node --transpile-only scripts/createAccount.ts",
    "import-parents": "ts-node --transpile-only scripts/importParentsCsv.ts",
    "import-students": "ts-node --transpile-only scripts/importStudentsCsv.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
